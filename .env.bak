# Environment Variables (環境變數設定檔)
# 使用說明: 複製此檔案為 .env 並填入實際數值
# 安全警告: .env 包含敏感資訊，請絕對不要提交至 Git 版本控制系統

# ==========================================
# 1. 資料庫設定 (Database)
# ==========================================
# PostgreSQL `postgres` 超級用戶的密碼
# 建議: 使用強密碼，例如由 1Password 生成
POSTGRES_PASSWORD=0824-ii-n-8-Su

# ==========================================
# 2. Supabase 安全設定 (Supabase Security)
# ==========================================
# 用於簽署 JWT Tokens 的密鑰
# 產生方法: 在終端機執行 `openssl rand -base64 32`
JWT_SECRET=r79BMqU5WfrEwYqZzBb3bCWbZndhJ0cjVHhhJMmz

# Anon Key (公開金鑰): 用於前端瀏覽器端 (Client-side)
# 說明: 權限受 RLS (Row Level Security) 限制，可安全暴露給前端
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Service Role Key (服務金鑰): 用於後端 API (Server-side)
# 警告: 擁有繞過 RLS 的最高權限，絕對不可暴露給前端
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# 應用程式網址 (用於 Auth Redirect)
SITE_URL=http://localhost:3000

