# Environment Variables (環境變數設定檔)
# 使用說明: 複製此檔案為 .env 並填入實際數值
# 安全警告: .env 包含敏感資訊，請絕對不要提交至 Git 版本控制系統

# ==========================================
# 1. 資料庫設定 (Database)
# ==========================================
# PostgreSQL `postgres` 超級用戶的密碼
# 建議: 使用強密碼，例如由 1Password 生成
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
SUPABASE_URL=http://localhost:8000

# Next.js 前端專用 (必須以 NEXT_PUBLIC_ 開頭才能在瀏覽器端使用)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
INTERNAL_SUPABASE_URL=http://localhost:8000

# ==========================================
# 2. Supabase 安全設定 (Supabase Security)
# ==========================================
# 用於簽署 JWT Tokens 的密鑰
# 產生方法: 在終端機執行 `openssl rand -base64 32`
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Anon Key (公開金鑰): 用於前端瀏覽器端 (Client-side)
# 說明: 權限受 RLS (Row Level Security) 限制，可安全暴露給前端
ANON_KEY=your_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service Role Key (服務金鑰): 用於後端 API (Server-side)
# 警告: 擁有繞過 RLS 的最高權限，絕對不可暴露給前端
SERVICE_ROLE_KEY=your_service_role_key

# 應用程式網址 (用於 Auth Redirect)
SITE_URL=http://localhost:3000

# ==========================================
# 3. 外部數據 API (External Data APIs)
# ==========================================
# 說明: 系統支援多組 API Key 以進行負載平衡 (Load Balancing) 與輪詢

# [Tiingo] 美股行情與加密貨幣數據
# 申請: https://www.tiingo.com/
TIINGO_API_KEY_1=your_tiingo_api_key_1
TIINGO_API_KEY_2=your_tiingo_api_key_2
TIINGO_API_KEY_3=your_tiingo_api_key_3
TIINGO_API_KEY_4=your_tiingo_api_key_4

# [Fugle] 台股即時行情 (富果)
# 申請: https://developer.fugle.tw/
FUGLE_API_KEY_1=your_fugle_api_key_1
FUGLE_API_KEY_2=your_fugle_api_key_2

# [Google Gemini] 生成式 AI 模型
# 申請: https://aistudio.google.com/
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5

# [Finnhub] 美股基本面與新聞
# 申請: https://finnhub.io/
FINNHUB_API_KEY_1=your_finnhub_api_key_1
FINNHUB_API_KEY_2=your_finnhub_api_key_2

# [Alpha Vantage] 外匯與技術指標
ALPHAVANTAGE_API_KEY_1=your_alpha_vantage_api_key_1

# [BEA] 美國經濟分析局數據 (GDP)
BEA_API_KEY_1=your_bea_api_key_1

# [Marketstack/MarketAux] 新聞情緒數據
MARKETAUX_API_KEY_1=your_marketaux_api_key_1

# [FRED] 美聯儲經濟數據 (Macronomics)
# 申請: https://fred.stlouisfed.org/docs/api/
FRED_API_KEY_1=your_fred_api_key_1

# [GoldAPI] 黃金與貴金屬報價
GOLD_IO_API_KEY_1=your_gold_io_api_key_1

# [Exchange Rate API] 匯率數據
EXCHANGE_RATE_API_KEY_1=your_exchange_rate_api_key_1

# [FMP] Financial Modeling Prep (財報數據)
FMP_API_KEY_1=your_fmp_api_key_1

# [SEC API] 美國證券交易委員會數據
SEC_API_KEY_1=your_sec_api_key_1
SEC_API_KEY_2=your_sec_api_key_2

# ==========================================
# 4. 選項功能與未來擴充 (Optional / Future)
# ==========================================
# Supabase Studio (儀表板) 設定
# 說明: 若您啟用 docker-compose 中的 `studio` 服務，需設定此帳密
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-dashboard-password

# Supabase Vault (加密儲存) 設定 (Lite 架構暫未使用)
# SECRET_KEY_BASE=your-secret-key-base
# VAULT_ENC_KEY=your-vault-encryption-key

# PostgreSQL Meta 加密金鑰
# PG_META_CRYPTO_KEY=your-pg-meta-crypto-key
